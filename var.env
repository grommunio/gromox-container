# grommunio container defaults.
#
# Do not edit this file for your deployment: copy the variables you want to
# change into var.local.env (git-ignored, read after this file) and run
# "docker compose up -d". Database credentials must match the MariaDB
# services in docker-compose.yml.

# ── Core database (gromox) ─────────────────────────────────────────
MYSQL_HOST=gromox-db
MYSQL_USER=grommunio
MYSQL_PASS=Lu3s3WmFxXghtLwJnuqN
MYSQL_DB=grommunio
# Only needed when CLEAR_DBS=true
MYSQL_ROOT_PASS=Lu3s3WmFxXghtLwJnuqN

# ── Optional feature databases ─────────────────────────────────────
CHAT_MYSQL_HOST=chat-db
CHAT_MYSQL_USER=grochat
CHAT_MYSQL_PASS=grommunio
CHAT_MYSQL_DB=grochat

FILES_MYSQL_HOST=files-db
FILES_MYSQL_USER=grofiles
FILES_MYSQL_PASS=grommunio
FILES_MYSQL_DB=grofiles

OFFICE_MYSQL_HOST=office-db
OFFICE_MYSQL_USER=groffice
OFFICE_MYSQL_PASS=grommunio
OFFICE_MYSQL_DB=groffice

ARCHIVE_MYSQL_HOST=archive-db
ARCHIVE_MYSQL_USER=groarchive
ARCHIVE_MYSQL_PASS=grommunio
ARCHIVE_MYSQL_DB=groarchive

# ── Credentials ────────────────────────────────────────────────────
# grommunio admin (admin UI https://FQDN:8443, also used for the rspamd UI)
ADMIN_PASS=admin
# grommunio-chat system admin ("admin")
CHAT_ADMIN_PASS=sfaedre3r32re23
# grommunio Files admin ("admin")
FILES_ADMIN_PASS=sfaedre3r32re23
# grommunio Archive built-in accounts admin@local / auditor@local
# (default to ADMIN_PASS when empty)
ARCHIVE_ADMIN_PASS=
ARCHIVE_AUDIT_PASS=

# ── Identity ───────────────────────────────────────────────────────
FQDN=mail.pallas.grommun.io
DOMAIN=pallas.grommun.io
TIMEZONE=Europe/Vienna
# Outbound SMTP relay ("[host]:port"), empty = direct delivery
RELAYHOST=

# ── Features ───────────────────────────────────────────────────────
ENABLE_CHAT=true
CHAT_CONFIG=/etc/grommunio-chat/config.json

ENABLE_FILES=true
FILES_HOST=gromox-office

ENABLE_OFFICE=true
OFFICE_HOST=gromox-office

ENABLE_ARCHIVE=true
ARCHIVE_HOST=gromox-archive
# Retention of newly archived mail in days (piler default_retention_days)
ARCHIVE_RETENTION_DAYS=2557
# Sphinx indexing intervals (sleep(1) format: 600, 10m, 1h)
ARCHIVE_INDEXER_DELTA_INTERVAL=10m
ARCHIVE_INDEXER_MAIN_INTERVAL=24h

# Full-text search index for grommunio-web (cron schedule, empty disables)
INDEX_SCHEDULE=*/15 * * * *

# Keycloak SSO (optional)
ENABLE_KEYCLOAK=false
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ── TLS ────────────────────────────────────────────────────────────
# 0 = certificate from a built-in CA, 2 = Let's Encrypt (port 80 must be reachable),
# 3 = own certificate: SSL_BUNDLE / SSL_KEY name files inside gromox-core
#     (mount them, e.g. under /etc/grommunio-common/ssl/own/)
SSL_INSTALL_TYPE=0
SSL_BUNDLE=
SSL_KEY=
# Contact address for Let's Encrypt (default: admin@DOMAIN)
SSL_EMAIL=
# Additional domains for the Let's Encrypt certificate (comma separated)
MAIL_DOMAINS=

# ── Maintenance ────────────────────────────────────────────────────
# DANGER: drop and recreate the core gromox database on (re)initialisation.
CLEAR_DBS=false
# Re-run the one-time initialisation on the next start (see README)
FORCE_RECONFIG=false
LOGFILE=/var/log/grommunio-setup.log
