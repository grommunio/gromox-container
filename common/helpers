writelog(){

  echo "$(date '+%Y-%m-%d %H:%M:%S :: ')" "$1" >> "${LOGFILE}"

}

# logmsg TEXT: timestamped line to the console and the setup log (once, when
# the log is the console itself, i.e. LOG_TO_STDOUT / LOGFILE=/dev/stdout)
logmsg(){
  local line
  line="$(date '+%Y-%m-%d %H:%M:%S') $*"
  case "${LOGFILE:-}" in
    ""|/dev/stdout|/dev/stderr|/dev/null) echo "${line}" ;;
    *) echo "${line}" | tee -a "${LOGFILE}" ;;
  esac
}

generate_g_cf_files(){
  FILENAME=$1

  declare -A INPUTS=(
   [user]=$MYSQL_USER
   [password]=$MYSQL_PASS
   [dbname]=$MYSQL_DB
   [hosts]=$MYSQL_HOST
   [query]=$2
  )

  : > "${FILENAME}"

  for elem in "${!INPUTS[@]}"
  do
   echo "${elem} = ${INPUTS[${elem}]}" >> "${FILENAME}"
  done
}

generate_admin_db_conf(){
  FILENAME=$1

  declare -A INPUTS=(
   [user]=$MYSQL_USER
   [pass]=$MYSQL_PASS
   [database]=$MYSQL_DB
   [host]=$MYSQL_HOST
  )

  echo "DB:" > "${FILENAME}"

  for elem in "${!INPUTS[@]}"
  do
   echo "  ${elem}: '${INPUTS[${elem}]//\'/\'\'}'" >> "${FILENAME}"
  done
}

