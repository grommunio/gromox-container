container=docker

CHAT_ADMIN_PASS=sfaedre3r32re23
FILES_ADMIN_PASS=sfaedre3r32re23
ADMIN_PASS=admin

ORIGFQDN=mail.pallas.grommun.io  
FQDN=mail.pallas.grommun.io
ORIGDOMAIN=pallas.grommun.io
DOMAIN=pallas.grommun.io
RELAYHOST=""

REPO_USER="your_repo_user"
REPO_PASS="your_repo_password"

CLEAR_DBS="true"

LOGFILE="/var/log/grommunio-setup.log"

CHAT_CONFIG="/etc/grommunio-chat/config.json"

ORGANIZATION="grommunio"
TIMEZONE="Europe/Vienna"
HTTP_PROXY_USER="localhost"
HTTP_PROXY_DOMAIN="localhost"

ENABLE_ARCHIVE="true"
ARCHIVE_HOST=gromox-archive
ARCHIVE_INDEXER_DELTA_INTERVAL=10m
ARCHIVE_INDEXER_MAIN_INTERVAL=24h

ENABLE_OFFICE="true"
OFFICE_HOST=gromox-office

ENABLE_FILES="true"
FILES_HOST=gromox-office

#Choose Install type, 0 for self signed and 2 for letsencrypt.
SSL_INSTALL_TYPE=0

SSL_COUNTRY="XX"
SSL_STATE="XX"
SSL_LOCALITY="X"
SSL_ORG="grommunio Appliance"
SSL_OU="IT"
SSL_EMAIL="admin@${DOMAIN}"
SSL_DAYS=30
SSL_PASS=grommunio
