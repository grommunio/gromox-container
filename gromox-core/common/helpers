writelog(){

  echo "$(date '+%Y-%m-%d %H:%M:%S :: ')" "$1" >> "${LOGFILE}"

}

generate_g_cf_files(){
  FILENAME=$1

  declare -A INPUTS=(
   [user]=$MYSQL_USER
   [password]=$MYSQL_PASS
   [dbname]=$MYSQL_DB
   [hosts]=$MYSQL_HOST
   [query]=$2
  )

  : > "${FILENAME}"

  for elem in "${!INPUTS[@]}"
  do
   echo "${elem} = ${INPUTS[${elem}]}" >> "${FILENAME}"
  done
}

generate_admin_db_conf(){
  FILENAME=$1

  declare -A INPUTS=(
   [user]=$MYSQL_USER
   [pass]=$MYSQL_PASS
   [database]=$MYSQL_DB
   [host]=$MYSQL_HOST
  )

  echo "DB:" > "${FILENAME}"

  for elem in "${!INPUTS[@]}"
  do
   echo "  ${elem}: '${INPUTS[${elem}]//\'/\'\'}'" >> "${FILENAME}"
  done
}

generate_admin_chat_conf(){
  FILENAME=$1

  cat > "${FILENAME}" <<EOF
chat:
  connection:
    login_id: admin
    password: '${CHAT_ADMIN_PASS//\'/\'\'}'
    url: 'localhost'
    basepath: /chat/api/v4
    port: 8065
    scheme: http
    verify: False
EOF
}

# setconf FILE PARAM VALUE [SPACING]
# Set "PARAM=VALUE" (or "PARAM = VALUE" when SPACING is 0) in FILE, replacing an
# existing assignment of exactly PARAM or appending it. VALUE may contain any
# character; it is escaped for sed.
setconf() {

  local FILE="$1" PARAM="$2" VAL="$3" SPACING="${4:-1}" ESCVAL LINE
  if [ -z "${FILE}" ] || [ -z "${PARAM}" ] || [ -z "${VAL}" ] ; then
    return 1
  fi
  if [ "${SPACING}" = "1" ]; then
    LINE="${PARAM}=${VAL}"
  else
    LINE="${PARAM} = ${VAL}"
  fi
  if [ -f "${FILE}" ] && grep -qE "^${PARAM}[[:space:]]*=" "${FILE}"; then
    ESCVAL=$(printf '%s' "${LINE}" | sed -e 's/[\\&|]/\\&/g')
    sed -i -E "s|^${PARAM}[[:space:]]*=.*|${ESCVAL}|" "${FILE}"
  else
    echo "${LINE}" >>"${FILE}"
  fi
  return 0

}

randpw(){

  < /dev/urandom tr -dc A-Za-z0-9 | head -c"${1:-16}";echo;

}
